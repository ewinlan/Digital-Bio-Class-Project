
library(DESeq2)
library(dplyr)

counts_raw <- read.delim("counts.txt", comment.char = "#", check.names = FALSE)

count_data <- counts_raw[, 7:ncol(counts_raw)]
rownames(count_data) <- counts_raw$Geneid

colnames(count_data) <- c(
  "WTOP50_rep1",
  "WTOP50_rep2",
  "WTPA14_rep1",
  "WTPA14_rep2"
)

col_data <- data.frame(
  row.names = colnames(count_data),
  condition = c("OP50", "OP50", "PA14", "PA14")
)

dds <- DESeqDataSetFromMatrix(
  countData = count_data,
  colData = col_data,
  design = ~ condition
)

dds <- dds[rowSums(counts(dds)) > 10, ]

dds <- DESeq(dds)

res <- results(dds, contrast = c("condition", "PA14", "OP50"))

res_df <- as.data.frame(res)
res_df$gene_id <- rownames(res_df)

write.csv(res_df, "DESeq2_results.csv", row.names = FALSE)

changed_genes <- read.csv("unique_genes_10pct_changed_sites_PA14_counts.csv")

merged <- changed_genes %>%
  left_join(res_df, by = "gene_id")

merged %>%
  summarize(
    total_genes = n(),
    significant_DE = sum(padj < 0.05, na.rm = TRUE),
    not_DE = sum(padj >= 0.05, na.rm = TRUE)
  )

